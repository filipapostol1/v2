<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 650 220" width="100%" height="100%">
  <rect width="650" height="220" fill="#ffffff"/>
  
  <!-- Strada a S -->
  <path d="M 40,140 C 60,60 140,60 160,110 C 180,160 220,130 230,80" 
        fill="none" stroke="#1e3a8a" stroke-width="12" stroke-linecap="round"/>
  <path d="M 120,110 C 140,160 210,150 230,80" 
        fill="none" stroke="#dc2626" stroke-width="12" stroke-linecap="round"/>
  
  <!-- Pin Traguardo -->
  <circle cx="230" cy="60" r="15" fill="#dc2626"/>
  <polygon points="217,68 243,68 230,90" fill="#dc2626"/>
  <circle cx="230" cy="60" r="5" fill="#ffffff"/>
  
  <!-- Testo Logo Apostol Trasporti -->
  <text x="260" y="100" font-family="'Segoe UI', Arial, sans-serif" font-weight="900" font-size="48" fill="#1e3a8a">APOSTOL</text>
  <text x="260" y="140" font-family="'Segoe UI', Arial, sans-serif" font-weight="700" font-size="22" fill="#dc2626" letter-spacing="2">TRASPORTI &amp; LOGISTICA</text>
</svg>
